<?xml version="1.0" encoding="utf-8"?>
<!-- The remote sign-in screen. Full-bleed rather than a card: this is the one
     screen that stands alone — nothing behind it is usable until it is answered
     — and a small panel floating over a dimmed dashboard undersold that.

     Shown through MainActivity.showDialog(fullScreen = true), which lends the
     shared dialog host the whole window for the occasion. The background is the
     person's, the same one the loading screen and the dashboards run on; see
     BackdropView. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.cvapp.BackdropView
        android:id="@+id/otpSky"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/otpColumn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/otpLogo"
                android:layout_width="148dp"
                android:layout_height="148dp"
                android:src="@drawable/logo"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/otpBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="4dp"
                android:text="@string/otp_brand"
                android:fontFamily="@font/inter_display"
                android:textSize="27sp"
                android:letterSpacing="-0.01"
                android:clickable="true"
                android:focusable="true"
                android:tag="text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/otp_tagline"
                android:fontFamily="@font/inter_medium"
                android:textSize="13sp"
                android:letterSpacing="0.08"
                android:tag="accent" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/otp_body"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:gravity="center"
                android:tag="muted" />

            <TextView
                android:id="@+id/otpOpenBot"
                style="@style/Bubble.Sub"
                android:layout_marginTop="14dp"
                android:drawableStart="@drawable/ic_mdi_send"
                android:text="@string/otp_open_bot" />

            <EditText
                android:id="@+id/otpCodeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:inputType="number"
                android:maxLength="6"
                android:gravity="center"
                android:fontFamily="@font/jetbrains_mono"
                android:textSize="30sp"
                android:letterSpacing="0.35"
                android:hint="@string/otp_hint"
                android:padding="16dp"
                android:importantForAutofill="no"
                android:tag="field" />

            <TextView
                android:id="@+id/otpStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="13sp"
                android:gravity="center"
                android:visibility="gone"
                android:tag="text" />

            <!-- The form's buttons: at the right, the filled one last. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="end">

                <TextView
                    android:id="@+id/otpCancel"
                    style="@style/Bubble.Button"
                    android:text="@string/otp_cancel" />

                <TextView
                    android:id="@+id/otpSubmit"
                    style="@style/Bubble.Button.Filled"
                    android:layout_marginStart="8dp"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp"
                    android:text="@string/otp_submit" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Full content of the VPN sign-in card — this view owns the whole
     presentation (mirrors the standalone login.coyotes.vision page this
     replaces, minus the parts a native app doesn't need — see
     MainActivity.awaitOtpCode). Hosted in dialogCard, not a system dialog. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="26dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/logo"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/otpBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="4dp"
            android:text="@string/otp_brand"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/otp_tagline"
            android:textColor="#FF888888"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/otp_body"
            android:textColor="#FFCCCCCC"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/otpOpenBot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="8dp"
            android:text="@string/otp_open_bot"
            android:textColor="#FF8B9FF4"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <EditText
            android:id="@+id/otpCodeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:inputType="number"
            android:maxLength="6"
            android:gravity="center"
            android:textSize="26sp"
            android:textColor="#FFFFFFFF"
            android:letterSpacing="0.35"
            android:hint="@string/otp_hint"
            android:textColorHint="#FF3D3D3D"
            android:background="@drawable/otp_input_bg"
            android:padding="12dp"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/otpStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="12sp"
            android:gravity="center"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/otpCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/otp_cancel"
                android:textColor="#FF888888"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="12dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/otpSubmit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/otp_submit"
                android:textColor="#FF111111"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/dialog_button_primary_bg" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- Android needs "install unknown apps" granted before self-updates can be
     installed — see MainActivity.promptInstallPermission/beginUpdate.
     Hosted in dialogCard, not a system dialog. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔓"
            android:textSize="34sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/update_needs_permission_title"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/update_needs_permission_body"
            android:textColor="#FFCCCCCC"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="18dp">

            <TextView
                android:id="@+id/installPermLater"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update_action_later"
                android:textColor="#FF888888"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="12dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/installPermOpenSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update_open_settings"
                android:textColor="#FF111111"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/dialog_button_primary_bg" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- Android needs "install unknown apps" granted before self-updates can be
     installed — see MainActivity.promptInstallPermission/beginUpdate.
     A Bubble pop-up in dialogCard. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView style="@style/Bubble.Icon" android:src="@drawable/ic_mdi_shield_lock_open_outline" />

            <TextView
                style="@style/Bubble.PopupTitle"
                android:text="@string/update_needs_permission_title" />

        </LinearLayout>

        <TextView
            style="@style/Bubble.PopupBody"
            android:text="@string/update_needs_permission_body" />

        <LinearLayout style="@style/Bubble.Actions">

            <TextView
                android:id="@+id/installPermLater"
                style="@style/Bubble.Button"
                android:text="@string/update_action_later" />

            <TextView
                android:id="@+id/installPermOpenSettings"
                style="@style/Bubble.Button.Filled"
                android:layout_marginStart="8dp"
                android:text="@string/update_open_settings" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- A new build is out on GitHub Releases — see Updater/MainActivity.promptUpdate.
     Title and body are set from Kotlin (version name, size, release notes).
     Hosted in dialogCard, not a system dialog. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/logo"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/updateTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/updateBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FFCCCCCC"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="18dp">

            <TextView
                android:id="@+id/updateLater"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update_action_later"
                android:textColor="#FF888888"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="12dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/updateInstall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update_action_install"
                android:textColor="#FF111111"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/dialog_button_primary_bg" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>

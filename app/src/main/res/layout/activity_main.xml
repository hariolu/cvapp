<?xml version="1.0" encoding="utf-8"?>
<!-- Every colour on the app's own screens comes from the person's look (Look.kt)
     through the views' tags, see Bubble.paint(); the values written here are the
     engine's default look, for the moment before that. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cv_bg"
    android:tag="bg">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ══ LOADING / STATUS SCREEN ══ -->
    <!-- The one screen used for everything: initial load, the local⇄remote
         switch, and masking connection trouble. The browser never gets to show
         its own error UI — this screen and its log are all the user ever sees
         while the app sorts things out in the background.

         It is the house's look in the app's own hands: the person's background
         behind, Bubble's parts in their colour in front. -->
    <FrameLayout
        android:id="@+id/loadingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <com.cvapp.BackdropView
            android:id="@+id/loadingSky"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Instead of the sky once a page has been up: that page as it was,
             softened and dimmed, so finding the way back does not jump to
             another screen and back. See MainActivity.freezePage(). -->
        <ImageView
            android:id="@+id/loadingPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:contentDescription="@null"
            android:visibility="gone" />

        <View
            android:id="@+id/loadingDim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- The app's settings. Long-pressing this screen opens them as well, but a
             screen that is up for a couple of seconds needs a door you can see. -->
        <ImageView
            android:id="@+id/loadingSettings"
            style="@style/Bubble.SubIcon"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:src="@drawable/ic_mdi_cog_outline"
            android:contentDescription="@string/settings_title"
            android:alpha="0" />

        <LinearLayout
            android:id="@+id/loadingColumn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <ImageView
                android:id="@+id/loadingLogo"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:src="@drawable/logo"
                android:scaleType="fitCenter"
                android:layout_marginBottom="22dp"
                android:contentDescription="@null"
                android:alpha="0" />

            <TextView
                android:id="@+id/loadingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loading_title"
                android:fontFamily="@font/inter_display"
                android:textSize="26sp"
                android:letterSpacing="-0.01"
                android:tag="text"
                android:alpha="0" />

            <!-- Good evening, and the name this phone is signed in to Home
                 Assistant with, once a page has said it. -->
            <TextView
                android:id="@+id/loadingGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter_medium"
                android:textSize="14sp"
                android:tag="accent"
                android:alpha="0" />

            <!-- Which way the app reached the house: the chosen one fills with the
                 person's colour. The remote one shows the tunnel's progress. -->
            <LinearLayout
                android:id="@+id/routeRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="horizontal"
                android:alpha="0">

                <TextView
                    android:id="@+id/routeLocal"
                    style="@style/Bubble.Sub"
                    android:clickable="false"
                    android:focusable="false"
                    android:drawableStart="@drawable/ic_mdi_home_outline"
                    android:text="@string/route_local" />

                <TextView
                    android:id="@+id/routeRemote"
                    style="@style/Bubble.Sub"
                    android:layout_marginStart="8dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:drawableStart="@drawable/ic_mdi_cloud_outline"
                    android:text="@string/route_remote" />

            </LinearLayout>

            <!-- The connect log: what already happened, oldest first and faintest,
                 right above what is happening now. Fixed height on purpose: lines
                 arrive one at a time, and the card below would walk down the screen
                 otherwise. Filled by MainActivity.step(). -->
            <LinearLayout
                android:id="@+id/loadingLog"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:gravity="bottom|center_horizontal"
                android:alpha="0" />

            <!-- What is happening now, as a Bubble button card: the step's icon and
                 words, and under them the address actually being dialled — the
                 first thing worth knowing when a connection misbehaves. -->
            <LinearLayout
                android:id="@+id/statusCard"
                style="@style/Bubble.Card"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="0dp"
                android:alpha="0">

                <ImageView
                    android:id="@+id/statusIcon"
                    style="@style/Bubble.Icon" />

                <LinearLayout style="@style/Bubble.Text">

                    <TextView
                        android:id="@+id/statusName"
                        style="@style/Bubble.Name" />

                    <TextView
                        android:id="@+id/statusEndpoint"
                        style="@style/Bubble.State"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/statusSpinner"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="7dp"
                    android:indeterminate="true"
                    android:tag="spinner" />

            </LinearLayout>

            <!-- A try that failed: what each way in found, when the next try
                 goes, and a button for now. The screen holds still until then:
                 no switching back and forth while it waits. -->
            <LinearLayout
                android:id="@+id/troubleBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/troubleChecks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/troubleNext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/inter_medium"
                    android:textSize="12sp"
                    android:tag="muted" />

                <TextView
                    android:id="@+id/troubleRetry"
                    style="@style/Bubble.Button.Filled"
                    android:layout_marginTop="10dp"
                    android:drawableStart="@drawable/ic_mdi_refresh"
                    android:text="@string/loading_retry" />

            </LinearLayout>

        </LinearLayout>

        <!-- Bottom row: who this is on the left, which build on the right. -->
        <TextView
            android:id="@+id/loadingBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="16dp"
            android:text="@string/otp_brand"
            android:textSize="11sp"
            android:letterSpacing="0.04"
            android:tag="faint"
            android:alpha="0" />

        <TextView
            android:id="@+id/loadingVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:padding="8dp"
            android:textSize="11sp"
            android:tag="faint"
            android:alpha="0" />

    </FrameLayout>

    <!-- ══ IN-APP DIALOGS ══ -->
    <!-- Every dialog in this app (OTP sign-in, settings, update prompts, the
         link-permission hint) animates in here instead of a system AlertDialog
         window — the same look on every OEM skin. A card is Bubble's pop-up; a
         full-screen page brings its own background. One slot: only one dialog is
         ever on screen at a time. Content is inflated into dialogCard at runtime,
         see MainActivity.showDialog(). -->
    <FrameLayout
        android:id="@+id/dialogScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#73000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/dialogCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:outlineProvider="background"
            android:clipToOutline="true"
            android:elevation="8dp"
            android:clickable="true"
            android:focusable="true" />

    </FrameLayout>

</FrameLayout>

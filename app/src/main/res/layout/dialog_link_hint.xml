<?xml version="1.0" encoding="utf-8"?>
<!-- First-run hint: web links need one-time approval on Android 12+.
     A Bubble pop-up in dialogCard. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView style="@style/Bubble.Icon" android:src="@drawable/ic_mdi_link_variant" />

        <TextView
            android:id="@+id/linkHintTitle"
            style="@style/Bubble.PopupTitle"
            android:text="@string/link_hint_title" />

    </LinearLayout>

    <TextView
        android:id="@+id/linkHintBody"
        style="@style/Bubble.PopupBody" />

    <CheckBox
        android:id="@+id/linkHintDontShow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/link_hint_dont_show"
        android:textSize="13sp"
        android:tag="check" />

    <LinearLayout style="@style/Bubble.Actions">

        <TextView
            android:id="@+id/linkHintLater"
            style="@style/Bubble.Button"
            android:text="@string/link_hint_later" />

        <TextView
            android:id="@+id/linkHintOpenSettings"
            style="@style/Bubble.Button.Filled"
            android:layout_marginStart="8dp"
            android:text="@string/link_hint_open_settings" />

    </LinearLayout>

</LinearLayout>

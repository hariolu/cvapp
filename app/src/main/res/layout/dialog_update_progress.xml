<?xml version="1.0" encoding="utf-8"?>
<!-- Downloading a self-update — a determinate bar plus a percentage, so a slow
     connection still shows movement instead of looking hung. Not cancelable by
     tapping outside or the back button (see MainActivity.beginUpdate); the
     Cancel button here is the only way out. A Bubble pop-up in dialogCard. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView style="@style/Bubble.Icon" android:src="@drawable/ic_mdi_download" />

        <TextView
            style="@style/Bubble.PopupTitle"
            android:text="@string/update_downloading" />

        <TextView
            android:id="@+id/updateProgressLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/inter_medium"
            android:textSize="13sp"
            android:tag="muted" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/updateProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:max="100"
        android:indeterminate="true"
        android:tag="bar" />

    <LinearLayout style="@style/Bubble.Actions">

        <TextView
            android:id="@+id/updateProgressCancel"
            style="@style/Bubble.Button"
            android:text="@android:string/cancel" />

    </LinearLayout>

</LinearLayout>

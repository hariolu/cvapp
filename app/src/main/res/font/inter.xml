<?xml version="1.0" encoding="utf-8"?>
<!-- Inter, the CV theme's typeface, as the app's default (see themes.xml).
     "Bold" is Inter's 600: the weight the CV Panel and the dashboards' Bubble
     cards use for names and titles. Built by design/fonts.py. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font android:font="@font/inter_regular" android:fontStyle="normal" android:fontWeight="400"
        app:font="@font/inter_regular" app:fontStyle="normal" app:fontWeight="400" />
    <font android:font="@font/inter_semibold" android:fontStyle="normal" android:fontWeight="700"
        app:font="@font/inter_semibold" app:fontStyle="normal" app:fontWeight="700" />
</font-family>

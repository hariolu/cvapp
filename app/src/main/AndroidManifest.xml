<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Self-update. CVapp is distributed from GitHub Releases, not a store, so
         it installs its own updates. Android still requires the user to grant
         "install unknown apps" to this app once, in Settings. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- REMOTE is WireGuard-only (no more browser-style login portal) — see
         VpnManager.kt. FOREGROUND_SERVICE is what lets the tunnel survive the
         app leaving the foreground; Android already shows its own persistent
         "VPN connected" indicator regardless, that part can't be suppressed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.CVapp">

        <!-- singleTask: a link tapped while the app is already running has to reach
             the live WebView through onNewIntent, not spawn a second activity with
             a second WebView and a second HA session on top of the first. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Long-press the icon: CV Mail, Car Trips, App settings. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!-- App-private scheme — cvha://cv-panel#trips
                 Never needs domain verification, so it always works: HA actionable
                 notifications, home-screen shortcuts, QR codes, dashboard buttons. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${linkScheme}" />
            </intent-filter>

            <!-- Any instance subdomain — <slug>.coyotes.vision — which is what
                 CVBot already puts in its messages. A wildcard rather than one
                 named host: every house has its own subdomain, and naming one
                 would both leak it and pin this build to a single address.
                 Note "*." does not match the bare domain, so the marketing site
                 keeps opening in a browser, as it should.

                 Kept in its own filter: these are the hosts that can later carry
                 android:autoVerify + assetlinks.json, and a non-verifiable host
                 sharing the filter would drag the whole thing down with it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="*.${instanceDomain}" />
            </intent-filter>

            <!-- The local instance. Not verifiable at all (plain http, no publicly
                 reachable .well-known), so this one can only ever be switched on by
                 hand in Settings → Open by default. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="http"
                    android:host="${localHost}"
                    android:port="${localPort}" />
            </intent-filter>
        </activity>

        <!-- Home-screen mode: CVapp standing in for the launcher, so the device
             boots straight into the dashboard.

             An alias rather than another filter on MainActivity, and shipped
             android:enabled="false", because a HOME filter is visible to the
             whole system the moment it exists — every install would show up in
             Settings → Home app, where one stray tap replaces the user's
             launcher. LauncherMode enables this only when asked, and the
             package manager remembers that across updates.

             No LAUNCHER category here: MainActivity already has one, and a
             second would put a duplicate icon in the app drawer. -->
        <activity-alias
            android:name=".HomeActivity"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- The tunnel library's own VpnService — GoBackend binds to this under the
             hood, CVapp never subclasses or calls it directly. -->
        <service
            android:name="com.wireguard.android.backend.GoBackend$VpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Hands the downloaded APK to the system installer. Not exported: only
             this app may query it, and the installer gets in on a per-Intent
             read grant that expires with the Intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
